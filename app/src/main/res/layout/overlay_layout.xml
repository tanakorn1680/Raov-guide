<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC000000"
    android:padding="10dp"
    android:elevation="8dp">

    <!-- Header row: title + close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MOBA AI"
            android:textColor="#FFDD44"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Timer -->
        <TextView
            android:id="@+id/tvOverlayTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <!-- Close button -->
        <Button
            android:id="@+id/btnOverlayClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:background="#66FFFFFF"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Score -->
    <TextView
        android:id="@+id/tvOverlayScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="- ⚔ -"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- Phase -->
    <TextView
        android:id="@+id/tvOverlayPhase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="?"
        android:textColor="#AAFFAA"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <!-- Heroes detected -->
    <TextView
        android:id="@+id/tvOverlayHeroes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ยังไม่ตรวจพบฮีโร่"
        android:textColor="#BBBBBB"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44FFFFFF"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Tip -->
    <TextView
        android:id="@+id/tvOverlayTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📡 กำลังอ่านหน้าจอ..."
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="3"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
