<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ===== Expanded panel ===== -->
    <LinearLayout
        android:id="@+id/overlayPanel"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_panel"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Header: drag handle. Tap = show/hide debug line -->
        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/overlayStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOBA AI"
                    android:textColor="#F3F4F6"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvOverlayPhase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กำลังอ่านหน้าจอ"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCollapse"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="9dp"
                android:src="@drawable/ic_minimize"
                android:tint="#9CA3AF"
                android:contentDescription="ย่อ" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="6dp"
            android:background="#1FFFFFFF" />

        <!-- Allies -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ทีมเรา"
            android:textColor="#60A5FA"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvOverlayAllies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="6dp"
            android:text="—"
            android:textColor="#F3F4F6"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Enemies -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ศัตรู"
            android:textColor="#F87171"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvOverlayEnemies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="6dp"
            android:text="—"
            android:textColor="#F3F4F6"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="6dp"
            android:background="#1FFFFFFF" />

        <!-- Tip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="คำแนะนำ"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvOverlayTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="6dp"
            android:text="รอข้อมูลจากหน้าจอ"
            android:textColor="#F3F4F6"
            android:textSize="12sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2" />

        <!-- Debug line (hidden by default; tap the header to show) -->
        <TextView
            android:id="@+id/tvOverlayDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:text="v7"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:maxLines="3"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Collapsed bubble ===== -->
    <FrameLayout
        android:id="@+id/overlayBubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_overlay_bubble">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AI"
            android:textColor="#F3F4F6"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

</FrameLayout>
